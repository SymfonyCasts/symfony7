{% extends 'base.html.twig' %}

{% block title %}Sign in{% endblock %}

{% block body %}
    <section class="px-6 py-10 sm:py-16">
        <div class="mx-auto max-w-md">
            <div class="rounded-2xl border border-white/10 bg-[#16202A]/80 p-8 shadow-2xl shadow-black/30 backdrop-blur-sm">
                <div class="mb-8">
                    <p class="text-sm font-semibold uppercase tracking-[0.3em] text-cyan-300">Security</p>
                    <h1 class="mt-3 text-4xl font-semibold">Sign in</h1>
                    <p class="mt-3 text-sm text-white/70">Use your email and password to continue.</p>
                </div>

                <form method="post" class="space-y-6">
                    {% if error %}
                        <div class="rounded-lg border border-red-400/40 bg-red-500/10 px-4 py-3 text-sm text-red-100">
                            {{ error.messageKey|trans(error.messageData, 'security') }}
                        </div>
                    {% endif %}

                    {% if app.user %}
                        <div class="rounded-lg border border-white/10 bg-white/5 px-4 py-3 text-sm text-white/80">
                            You are logged in as {{ app.user.userIdentifier }},
                            <a class="font-semibold text-cyan-300 hover:text-cyan-200" href="{{ logout_path() }}">logout</a>
                        </div>
                    {% endif %}

                    <div>
                        <label for="username" class="mb-2 block text-sm font-medium text-white/80">Email</label>
                        <input
                            type="email"
                            value="{{ last_username }}"
                            name="_username"
                            id="username"
                            class="block w-full rounded-lg border border-white/10 bg-white/5 px-4 py-3 text-white placeholder:text-white/40 focus:border-cyan-400 focus:ring-cyan-400"
                            autocomplete="email"
                            required
                            autofocus
                        >
                    </div>

                    <div>
                        <label for="password" class="mb-2 block text-sm font-medium text-white/80">Password</label>
                        <input
                            type="password"
                            name="_password"
                            id="password"
                            class="block w-full rounded-lg border border-white/10 bg-white/5 px-4 py-3 text-white placeholder:text-white/40 focus:border-cyan-400 focus:ring-cyan-400"
                            autocomplete="current-password"
                            required
                        >
                    </div>

                    <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

                    <div class="flex items-center gap-3 rounded-lg border border-white/10 bg-white/5 px-4 py-3 text-sm text-white/80">
                        <input type="checkbox" checked name="_remember_me" id="_remember_me" class="rounded border-white/20 bg-transparent text-cyan-400 focus:ring-cyan-400">
                        <label for="_remember_me">Remember me</label>
                    </div>

                    <button class="w-full rounded-lg bg-green-700 px-5 py-3 font-semibold text-white transition hover:bg-green-800 cursor-pointer" type="submit">
                        Sign in
                    </button>
                </form>
            </div>
        </div>
    </section>
{% endblock %}
