diff --git a/src/Entity/StarshipPart.php b/src/Entity/StarshipPart.php
new file mode 100644
index 0000000..b1286f1
--- /dev/null
+++ b/src/Entity/StarshipPart.php
@@ -0,0 +1,35 @@
+<?php
+
+namespace App\Entity;
+
+use App\Repository\StarshipPartRepository;
+use Doctrine\ORM\Mapping as ORM;
+
+#[ORM\Entity(repositoryClass: StarshipPartRepository::class)]
+class StarshipPart
+{
+    #[ORM\Id]
+    #[ORM\GeneratedValue]
+    #[ORM\Column]
+    private ?int $id = null;
+
+    #[ORM\ManyToOne(inversedBy: 'starshipParts')]
+    private ?Starship $starship = null;
+
+    public function getId(): ?int
+    {
+        return $this->id;
+    }
+
+    public function getStarship(): ?Starship
+    {
+        return $this->starship;
+    }
+
+    public function setStarship(?Starship $starship): static
+    {
+        $this->starship = $starship;
+
+        return $this;
+    }
+}
