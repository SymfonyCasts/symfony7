@@ -0,0 +1,40 @@
+name: Composer Security Audit
+
+on:
+    schedule:
+        - cron: '0 12 * * 1' # Every Monday at 12:00 PM (Noon) UTC
+
+permissions:
+    contents: read
+
+jobs:
+    composer-audit:
+        runs-on: ubuntu-latest
+
+        steps:
+            - name: Checkout code
+              uses: actions/checkout@v6
+
+            - name: Setup Composer
+              uses: shivammathur/setup-php@v2
+              with:
+                  tools: composer
+
+            - name: Run Composer audit
+              run: composer audit --locked
+
